# ===============================
# EduBrowser Backend Configuration
# ===============================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Database Configuration (REQUIRED)
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_PORT=3306

# JWT Secret (REQUIRED)
# MUST match the PHP API JWT_SECRET exactly (config.php or environment variable)
# If they differ, you'll get "Invalid or expired token" errors
JWT_SECRET=your_jwt_secret_key_here

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=5000

# React Dashboard Configuration
DASHBOARD_URL=https://yourdomain.com
API_BASE_URL=https://api.yourdomain.com
DASHBOARD_PORT=3000
VITE_API_URL=https://api.yourdomain.com

# Environment
NODE_ENV=production

# Google Safe Browsing API (Optional)
GOOGLE_SAFEBROWSING_API_KEY=your_api_key_here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
