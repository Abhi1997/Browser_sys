{
  "info": {
    "name": "DCES Dashboard API",
    "description": "Postman collection for testing the DCES Dashboard PHP API (api.abhinavpaudel.com).\n\n**Setup:**\n1. Set `base_url` to your API (e.g. https://api.abhinavpaudel.com or http://localhost for local PHP).\n2. Run **Auth → Login** with valid credentials.\n3. The token is saved automatically; use it for all other requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://api.abhinavpaudel.com" },
    { "key": "token", "value": "" },
    { "key": "device_id", "value": "postman-test-device-001" },
    { "key": "user_id", "value": "" },
    { "key": "whitelist_id", "value": "" },
    { "key": "blacklist_id", "value": "" },
    { "key": "student_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.test('Token saved', () => pm.expect(pm.collectionVariables.get('token')).to.not.be.empty);",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has success', () => pm.expect(json).to.have.property('success', true));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"your_password\",\n  \"deviceId\": \"{{device_id}}\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Verify Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Device-ID", "value": "{{device_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{token}}\",\n  \"deviceId\": \"{{device_id}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/verify-token"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
