# API base URL for the DCES dashboard (PHP API on Hostinger).
# Used at build time: set VITE_API_URL when running `npm run build`.
# No trailing slash. Production: https://api.abhinavpaudel.com
VITE_API_URL=https://api.abhinavpaudel.com

# Local development (default if not set):
# VITE_API_URL=http://localhost:5000
