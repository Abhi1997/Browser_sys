# ===============================
# EduBrowser Hostinger Configuration
# ===============================

# Database Configuration
DB_HOST=sr
DB_USER=u97
DB_PASSWORD=
DB_NAME=u9
DB_PORT=3306

# API Server Configuration
# For Hostinger, your backend will be accessed via subdomain or same domain
API_HOST=0.0.0.0
API_PORT=5000

# React Dashboard Configuration
# Dashboard at abhinavpaudel.com; PHP API at api.abhinavpaudel.com
DASHBOARD_URL=https://com
# API base URL for app-to-API calls (forgot password, etc.). Must be api.abhinavpaudel.com, not the dashboard URL.
API_BASE_URL=https://api.com
# The built React app calls this API URL for data
DASHBOARD_PORT=3000
VITE_API_URL=https://api.com

# JWT Secret - MUST match the PHP API at api.abhinavpaudel.com exactly (config.php or JWT_SECRET env on Hostinger).
# If they differ, the dashboard will get "Invalid or expired token". Copy the value from your PHP API config.
JWT_SECRET=ZnLQF


# Environment
NODE_ENV=production


# Google Safe Browsing (free mode): only open site after URL check. Get key: console.cloud.google.com → Safe Browsing API
GOOGLE_SAFEBROWSING_API_KEY=A
GOOGLE_CLIENT_ID=90
GOOGLE_CLIENT_SECRET=GO