# Database Configuration
# For Hostinger basic hosting, use 'localhost' as DB_HOST
# For remote database, use the actual hostname provided by Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_USER=u976383844_abhi097
DB_PASSWORD=your_database_password
DB_NAME=u976383844_dces

# Dashboard Configuration
# Dashboard at abhinavpaudel.com; PHP API at api.abhinavpaudel.com. DASHBOARD_URL = where the React dashboard is served (main site). No trailing slash.
DASHBOARD_URL=https://abhinavpaudel.com

# API base URL for React dashboard build (VITE_API_URL). Must match your PHP API on Hostinger.
# No trailing slash. Set this when building the dashboard: VITE_API_URL is used by the React app.
VITE_API_URL=https://api.abhinavpaudel.com

# API base URL when the Python app calls the hosted API (e.g. login, sync, reporting).
# No trailing slash. Production: https://api.abhinavpaudel.com
API_BASE_URL=https://api.abhinavpaudel.com

# JWT Secret Key (MUST match PHP API at api.abhinavpaudel.com exactly)
# Use ONLY the secret string here—no PHP code or extra characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# How to match: see docs/JWT_SECRET_MATCH.md
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google Safe Browsing API (for free mode URL check - only open site after check)
# Get key: https://console.cloud.google.com/apis/credentials (enable Safe Browsing API)
GOOGLE_SAFEBROWSING_API_KEY=your-api-key-here

# Optional: Gmail OAuth (if using Gmail login)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
